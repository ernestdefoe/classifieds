{
    "name": "ernestdefoe/classifieds",
    "description": "Classified ads for Flarum, with section/row/seat details and a stadium seat locator for ticket listings. A fork of ramon/classifieds.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "classifieds",
        "ads",
        "marketplace",
        "discussion"
    ],
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0-rc.1"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "authors": [
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        },
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com",
            "role": "Fork maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/classifieds/issues",
        "source": "https://github.com/ernestdefoe/classifieds"
    },
    "homepage": "https://github.com/ram0ng1/classifieds",
    "autoload": {
        "psr-4": {
            "Flarum\\Classifieds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flarum\\Classifieds\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "flarum-extension": {
            "title": "Classifieds (Seats)",
            "category": "feature",
            "icon": {
                "name": "fas fa-tag",
                "backgroundColor": "#15B715",
                "color": "#fff"
            }
        }
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}